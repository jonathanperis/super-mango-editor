# toml.dict — tokens libFuzzer may splice into an input (-dict=).
#
# Coverage-guided mutation changes bytes, and a mutated byte almost never
# turns one key into another: `x = 1` becomes `y = 1` by luck, never
# `patrol_x0 = 1`. Without a dictionary the search spends its time in the
# tokenizer and the "unknown key" path. With the words below it can build
# tables the loaders actually read.
#
# One quoted token per line; `make fuzz` passes this file to every harness.
# tests/fuzz_dict_test.py fails when a key of the level schema
# (src/shared/serializer_parse.c) is missing from the first block.

# Level keys and array names (serializer_parse.c).
"air_accel_run"
"air_accel_walk"
"air_friction"
"axe_traps"
"background_layers"
"base_y"
"birds"
"blue_flames"
"bouncepads_high"
