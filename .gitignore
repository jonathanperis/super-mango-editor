# Prerequisites
*.d

# Build output
out/
out-sanitize/
out-security-audit/
dist/
mango-experiment-*.toml

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.exp
# A linker map (-Wl,-Map=name.map) written next to the Makefile. Only the
# top folder: a blanket *.map would also hide the browser source maps
# (file.js.map, file.css.map) that belong with web code.
/*.map

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# debug information files
*.dwo

# Python bytecache
__pycache__/
*.pyc

# Generated files
.DS_Store
src/levels/exported/*.c
src/levels/exported/*.h
levels/_playtest.toml
compile_commands.json
.cache/clangd/
.cache/raylib/

# Docs generation
node_modules/

# Specifications. Everything in a subfolder of .specs/ (project/, features/,
# archive/, and any new one) is ordinary tracked content: a new spec file
# shows up in `git status` like any other file. Two places are for local
# notes and experiments and stay out of the repository:
#   .specs/scratch/   the folder to use for new scratch work
#   .specs/<file>     loose files directly in .specs/, where older scratch
#                     scripts and drafts still live
# The second line below re-includes every subfolder that the first one
# ignored; the third ignores the scratch folder again.
/.specs/*
!/.specs/*/
/.specs/scratch/

# Local Claude Code agent worktrees, checkouts and settings. Not part of the game.
.claude/

# Task-owned browser verification artifacts
playwright-evidence/
