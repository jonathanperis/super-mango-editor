---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '../../styles/docs.css';
import { DOCS_META, SECTION_CATEGORIES, SECTION_ORDER } from '@/lib/docsSidebar';

// docs-drift sentinel: level-catalog
const globResult = import.meta.glob('../../../wiki/*.md', { eager: true });

const pagesBySlug: Record<string, any> = {};
for (const [path, module] of Object.entries(globResult)) {
    const fileName = path.split('/').pop()!.replace('.md', '');
    const slug = fileName === 'index' ? 'home' : fileName;
    pagesBySlug[slug] = module;
}

const availableSlugs = new Set(Object.keys(pagesBySlug));
for (const id of SECTION_ORDER) {
    if (!availableSlugs.has(id)) {
        throw new Error(
            `Docs navigation references "${id}" but no matching wiki/${id}.md was found. Available slugs: ${Array.from(availableSlugs).join(', ')}`
        );
    }
}

const requestedSlug = Astro.params.slug;
const isRoot = requestedSlug === undefined;
const requestedKey = requestedSlug ?? 'home';
const currentPage = pagesBySlug[requestedKey];

if (!isRoot && !currentPage) {
    return Astro.redirect('/404');
}

export function getStaticPaths() {
    return [
        { params: { slug: undefined } },
        ...SECTION_ORDER.filter(s => s !== 'home').map(slug => ({ params: { slug } })),
    ];
}

function humanizeSlug(s: string): string {
    return s
        .split('-')
        .map(w => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ');
}

const pageMeta = DOCS_META[requestedKey as keyof typeof DOCS_META];
const pageTitle = isRoot
    ? 'Super Mango Builder Manual'
    : (currentPage?.frontmatter?.title ?? pageMeta?.label ?? humanizeSlug(requestedKey));

const base = import.meta.env.BASE_URL;
const baseClean = base.replace(/\/$/, '');
const docsBase = `${baseClean}/docs`;
const backHomeUrl = `${baseClean}/`;
const playUrl = `${baseClean}/#play`;
const repoUrl = 'https://github.com/jonathanperis/super-mango-editor';
const editorUrl = `${repoUrl}/blob/main/docs/wiki/${requestedKey === 'home' ? 'index' : requestedKey}.md`;
const categoryCards = SECTION_CATEGORIES.map(cat => ({
    ...cat,
    pages: cat.ids.map(id => DOCS_META[id]),
}));
const allPages = SECTION_ORDER.map(id => DOCS_META[id]);
const currentIndex = SECTION_ORDER.indexOf(requestedKey as any);
const prevPage = !isRoot && currentIndex > 0 ? DOCS_META[SECTION_ORDER[currentIndex - 1]] : null;
const nextPage = !isRoot && currentIndex >= 0 && currentIndex < SECTION_ORDER.length - 1 ? DOCS_META[SECTION_ORDER[currentIndex + 1]] : null;
const CurrentContent = currentPage?.default ?? currentPage;
---

<BaseLayout title={pageTitle}>
    <div class="mobile-header">
        <button class="menu-toggle" id="menuToggle" aria-label="Toggle menu" aria-controls="sidebar" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
        <a class="mobile-title" href={docsBase}>Builder Manual</a>
        <a class="mobile-play" href={playUrl}>Play</a>
    </div>

    <div class="overlay" id="overlay"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a class="repo-badge" href={docsBase}>
                <span>SM</span>
                <strong>Builder Manual</strong>
            </a>
            <p class="repo-description">Read the engine route, world-builder guide, and platform docs without one giant scroll.</p>
            <label class="search-label" for="searchInput">Filter pages</label>
            <input type="search" id="searchInput" class="search-box" placeholder="Filter all 15 manual pages..." aria-label="Filter manual pages">
            <p class="search-status" id="searchStatus" aria-live="polite">15 routes ready</p>
        </div>
        <nav class="sidebar-nav-container" aria-label="Documentation sections">
            {SECTION_CATEGORIES.map((cat) => (
                <div class="sidebar-category-group" data-category>
                    <div class="sidebar-category">{cat.label}</div>
                    <ul>
                        {cat.ids.map((id) => {
                            const meta = DOCS_META[id];
                            const href = id === 'home' ? docsBase : `${docsBase}/${id}/`;
                            const active = isRoot ? id === 'home' : id === requestedKey;
                            return (
                                <li>
                                    <a class:list={['nav-item', { active }]} href={href} data-nav-id={id} data-search-text={`${meta.label} ${meta.description} ${cat.label}`}>
                                        <span>{meta.shortLabel ?? meta.label}</span>
                                    </a>
                                </li>
                            );
                        })}
                    </ul>
                </div>
            ))}
        </nav>
        <div class="sidebar-footer">
            <a href={backHomeUrl}>← Home screen</a>
            <a href={playUrl}>Insert coin</a>
            <a href={repoUrl} target="_blank" rel="noopener noreferrer">GitHub source</a>
        </div>
    </aside>

    <div class="content-wrapper">
        <main class:list={['content', { 'content-hub': isRoot }]} id="mainContent">
            {isRoot ? (
                <>
                    <section class="docs-hero manual-cover" aria-labelledby="manual-title">
                        <div>
                            <p class="docs-kicker">SERVICE MANUAL / CABINET BACKPLANE</p>
                            <h1 id="manual-title">Trace every wire inside Super Mango</h1>
                            <p>Use the manual like a service bay: start with orientation, inspect the engine, open world-builder references, then verify builds and source ownership without one giant scroll.</p>
                            <div class="manual-diagnostics" aria-label="Manual diagnostics">
                                <span>15 routes indexed</span>
                                <span>C11 + SDL2</span>
                                <span>TOML levels</span>
                                <span>WASM cabinet</span>
                            </div>
                            <div class="docs-actions" aria-label="Primary manual actions">
                                <a href={`${docsBase}/developer-guide/`}>Start diagnostics</a>
                                <a href={playUrl}>Boot the cabinet</a>
                            </div>
                        </div>
                        <div class="manual-status manual-gauge" aria-label="Documentation stats">
                            <span>ROUTES</span>
                            <strong>{allPages.length}</strong>
                            <small>focused manual pages</small>
                            <dl class="manual-gauge-list">
                                {SECTION_CATEGORIES.map(cat => (
                                    <div>
                                        <dt>{cat.label}</dt>
                                        <dd>{cat.ids.length}</dd>
                                    </div>
                                ))}
                            </dl>
                        </div>
                    </section>

                    <section class="manual-route-grid service-routing-matrix" aria-label="Manual routes">
                        {categoryCards.map((cat) => (
                            <article class="route-card" data-doc-card data-search-text={`${cat.label} ${cat.description} ${cat.pages.map(p => `${p.label} ${p.description}`).join(' ')}`}>
                                <p class="card-kicker">{cat.kicker}</p>
                                <h2>{cat.label}</h2>
                                <p>{cat.description}</p>
                                <ul>
                                    {cat.pages.map((page) => (
                                        <li>
                                            <a href={page.id === 'home' ? docsBase : `${docsBase}/${page.id}/`}>
                                                <span>{page.marker}</span>
                                                {page.label}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </article>
                        ))}
                    </section>

                    <section class="manual-index" aria-labelledby="index-title">
                        <div class="section-heading-row">
                            <div>
                                <p class="docs-kicker">FULL INDEX</p>
                                <h2 id="index-title">Every manual page</h2>
                            </div>
                            <a href={repoUrl} target="_blank" rel="noopener noreferrer">Open source →</a>
                        </div>
                        <div class="index-list">
                            {allPages.map((page, index) => (
                                <a class="index-row" data-doc-card data-search-text={`${page.label} ${page.description} ${page.marker}`} href={page.id === 'home' ? docsBase : `${docsBase}/${page.id}/`}>
                                    <span>{String(index + 1).padStart(2, '0')}</span>
                                    <strong>{page.label}</strong>
                                    <em>{page.description}</em>
                                </a>
                            ))}
                        </div>
                    </section>
                </>
            ) : (
                <>
                    <div class="docs-breadcrumbs route-terminal" aria-label="Breadcrumb">
                        <a href={docsBase}>Builder Manual</a>
                        <span>/</span>
                        <span>{pageMeta?.label ?? pageTitle}</span>
                    </div>
                    <section class="doc-route-header" aria-label="Current manual route">
                        <p class="docs-kicker">{pageMeta?.marker ?? 'ROUTE'} / {pageMeta?.label ?? pageTitle}</p>
                        <h1>{pageMeta?.label ?? pageTitle}</h1>
                        <p>{pageMeta?.description ?? 'Source-backed service notes for the Super Mango cabinet.'}</p>
                        <div class="manual-diagnostics">
                            <a href={playUrl}>Boot cabinet</a>
                            <a href={docsBase}>Manual index</a>
                            <a href={editorUrl} target="_blank" rel="noopener noreferrer">Source markdown</a>
                        </div>
                    </section>
                    <section id={requestedKey} class="doc-section doc-page service-page">
                        <CurrentContent />
                    </section>
                    <nav class="doc-pager" aria-label="Documentation pagination">
                        {prevPage ? (
                            <a class="pager-card previous" href={`${docsBase}/${prevPage.id === 'home' ? '' : `${prevPage.id}/`}`}>
                                <span>Previous route</span>
                                <strong>{prevPage.label}</strong>
                            </a>
                        ) : <span></span>}
                        {nextPage ? (
                            <a class="pager-card next" href={`${docsBase}/${nextPage.id}/`}>
                                <span>Next route</span>
                                <strong>{nextPage.label}</strong>
                            </a>
                        ) : <span></span>}
                    </nav>
                    <div class="doc-feedback">
                        <a href={editorUrl} target="_blank" rel="noopener noreferrer">Edit this page on GitHub</a>
                        <a href={docsBase}>Back to manual index</a>
                    </div>
                </>
            )}
        </main>
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            const searchInput = document.getElementById('searchInput');
            const searchStatus = document.getElementById('searchStatus');
            const navItems = Array.from(document.querySelectorAll('.nav-item'));
            const docCards = Array.from(document.querySelectorAll('[data-doc-card]'));
            const categoryGroups = Array.from(document.querySelectorAll('[data-category]'));

            function setMenu(open) {
                sidebar?.classList.toggle('open', open);
                overlay?.classList.toggle('open', open);
                menuToggle?.setAttribute('aria-expanded', String(open));
            }

            menuToggle?.addEventListener('click', () => setMenu(!sidebar?.classList.contains('open')));
            overlay?.addEventListener('click', () => setMenu(false));
            navItems.forEach(item => item.addEventListener('click', () => {
                if (window.innerWidth <= 768) setMenu(false);
            }));

            searchInput?.addEventListener('input', (event) => {
                const query = event.target.value.trim().toLowerCase();
                navItems.forEach(item => {
                    const match = !query || item.dataset.searchText?.toLowerCase().includes(query);
                    item.parentElement.style.display = match ? '' : 'none';
                });
                categoryGroups.forEach(group => {
                    const visible = Array.from(group.querySelectorAll('li')).some(li => li.style.display !== 'none');
                    group.style.display = visible ? '' : 'none';
                });
                docCards.forEach(card => {
                    const match = !query || card.dataset.searchText?.toLowerCase().includes(query);
                    card.style.display = match ? '' : 'none';
                });
                const visibleRoutes = navItems.filter(item => item.parentElement.style.display !== 'none').length;
                if (searchStatus) {
                    searchStatus.textContent = query
                        ? (visibleRoutes ? `${visibleRoutes} matching routes` : 'No routes found')
                        : '15 routes ready';
                }
            });
        });
    </script>
</BaseLayout>
