---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '../../styles/docs.css';
import { DOCS_META, SECTION_CATEGORIES, SECTION_ORDER } from '@/lib/docsSidebar';
import { getCollection, render } from 'astro:content';
import Sprite from '@/components/Sprite.astro';
import CategoryMark from '@/components/CategoryMark.astro';
import { art } from '@/lib/art';

// docs-drift sentinel: level-catalog
// The manual is the `docs` content collection (src/content.config.ts): one
// entry per docs/wiki/*.md file, id = file name. index.md is the "home" page.
const entries = await getCollection('docs');
const entriesBySlug = new Map(entries.map(entry => [entry.id === 'index' ? 'home' : entry.id, entry]));

for (const id of SECTION_ORDER) {
    if (!entriesBySlug.has(id)) {
        throw new Error(
            `Docs navigation references "${id}" but no matching wiki/${id}.md entry was found. Available entries: ${Array.from(entriesBySlug.keys()).join(', ')}`
        );
    }
}
// The reverse check: a wiki page missing from the navigation would build no
// route and be unreachable, so list every page in src/lib/docsSidebar.ts.
for (const slug of entriesBySlug.keys()) {
    if (!(SECTION_ORDER as readonly string[]).includes(slug)) {
        throw new Error(`docs/wiki page "${slug}" is not listed in SECTION_ORDER (src/lib/docsSidebar.ts)`);
    }
}

const requestedSlug = Astro.params.slug;
const isRoot = requestedSlug === undefined;
const requestedKey = requestedSlug ?? 'home';
const currentPage = entriesBySlug.get(requestedKey);

// The navigation checks above guarantee every listed route has an entry;
// anything else is not a manual page.
if (!currentPage) {
    return Astro.redirect('/404');
}

export function getStaticPaths() {
    return [
        { params: { slug: undefined } },
        ...SECTION_ORDER.filter(s => s !== 'home').map(slug => ({ params: { slug } })),
    ];
}

function humanizeSlug(s: string): string {
    return s
        .split('-')
        .map(w => w.charAt(0).toUpperCase() + w.slice(1))
        .join(' ');
}

const pageMeta = DOCS_META[requestedKey as keyof typeof DOCS_META];
const pageTitle = isRoot
    ? 'The Super Mango manual'
    : (currentPage?.data.title ?? pageMeta?.label ?? humanizeSlug(requestedKey));

const base = import.meta.env.BASE_URL;
const baseClean = base.replace(/\/$/, '');
const docsBase = `${baseClean}/docs`;
const backHomeUrl = `${baseClean}/`;
const playUrl = `${baseClean}/#play`;
const repoUrl = 'https://github.com/jonathanperis/super-mango-editor';
const editorUrl = `${repoUrl}/blob/main/docs/wiki/${requestedKey === 'home' ? 'index' : requestedKey}.md`;
const categoryCards = SECTION_CATEGORIES.map(cat => ({
    ...cat,
    pages: cat.ids.map(id => DOCS_META[id]),
}));
const allPages = SECTION_ORDER.map(id => DOCS_META[id]);
const currentIndex = SECTION_ORDER.indexOf(requestedKey as any);
const prevPage = !isRoot && currentIndex > 0 ? DOCS_META[SECTION_ORDER[currentIndex - 1]] : null;
const nextPage = !isRoot && currentIndex >= 0 && currentIndex < SECTION_ORDER.length - 1 ? DOCS_META[SECTION_ORDER[currentIndex + 1]] : null;
// render() compiles the entry's Markdown into a component for this route.
const { Content: CurrentContent } = await render(currentPage);
const pageDescription = currentPage?.data.description ?? pageMeta.description;
const currentCategory = SECTION_CATEGORIES.find(cat => cat.ids.includes(requestedKey as any));
const pageHref = (id: string) => (id === 'home' ? `${docsBase}/` : `${docsBase}/${id}/`);
const coverStyle = [
    `--sky:url("${art.sky.src}")`,
    `--mountains:url("${art.mountains.src}")`,
    `--grass:url("${art.grassTile.src}")`,
].join(';');
---

<BaseLayout title={isRoot ? pageTitle : `${pageTitle} — Super Mango manual`} description={pageDescription} pageType="docs">
    <div class="mobile-header">
        <button class="menu-toggle" id="menuToggle" aria-label="Open the page list" aria-controls="sidebar" aria-expanded="false">
            <span></span><span></span><span></span>
        </button>
        <a class="mobile-title" href={`${docsBase}/`}>Super Mango manual</a>
        <a class="mobile-play" href={playUrl}>Play</a>
    </div>

    <div class="overlay" id="overlay"></div>

    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <a class="sidebar-brand" href={backHomeUrl}>
                <Sprite sheet={art.coin} scale={2} />
                <span>Super Mango</span>
            </a>
            <a class="sidebar-title" href={`${docsBase}/`}>The manual</a>
            <label class="search-label" for="searchInput">Find a page</label>
            <input type="search" id="searchInput" class="search-box" placeholder="Type to filter..." aria-label="Filter manual pages">
            <p class="search-status" id="searchStatus" aria-live="polite">{allPages.length} pages</p>
        </div>
        <nav class="sidebar-nav-container" aria-label="Manual pages">
            {SECTION_CATEGORIES.map((cat) => (
                <div class="sidebar-category-group" data-category>
                    <div class="sidebar-category">{cat.label}</div>
                    <ul>
                        {cat.ids.map((id) => {
                            const meta = DOCS_META[id];
                            const active = isRoot ? id === 'home' : id === requestedKey;
                            return (
                                <li>
                                    <a class:list={['nav-item', { active }]} href={pageHref(id)} aria-current={active ? 'page' : undefined} data-nav-id={id} data-search-text={`${meta.label} ${meta.description} ${cat.label}`}>
                                        {meta.shortLabel ?? meta.label}
                                    </a>
                                </li>
                            );
                        })}
                    </ul>
                </div>
            ))}
        </nav>
        <div class="sidebar-footer">
            <a href={playUrl}>Play the game</a>
            <a href={repoUrl} target="_blank" rel="noopener noreferrer">Source on GitHub</a>
        </div>
    </aside>

    <div class="content-wrapper">
        <main class:list={['content', { 'content-hub': isRoot }]} id="mainContent">
            {isRoot ? (
                <>
                    <section class="manual-cover" style={coverStyle} aria-labelledby="manual-title">
                        <div class="manual-cover-scene" aria-hidden="true">
                            <Sprite sheet={art.player} scale={3} row={0} frames={4} fps={6} class="cover-player" />
                        </div>
                        <div class="manual-cover-text">
                            <h1 id="manual-title">The Super Mango manual</h1>
                            <p>
                                {allPages.length} pages, written next to the code and checked against it.
                                Here to learn? Start with Sandbox School. Looking for something
                                specific? Everything is listed below, or filter the page list.
                            </p>
                            <div class="docs-actions">
                                <a class="pixel-button pixel-button-gold" href={`${docsBase}/learning-path/`}>Start with Sandbox School</a>
                                <a class="pixel-button pixel-button-ghost" href={playUrl}>Play the game</a>
                            </div>
                        </div>
                    </section>

                    <section class="manual-toc" aria-label="All manual pages">
                        {categoryCards.map((cat) => (
                            <div class="toc-group" data-doc-card data-search-text={`${cat.label} ${cat.description} ${cat.pages.map(p => `${p.label} ${p.description}`).join(' ')}`}>
                                <h2><CategoryMark category={cat.label} />{cat.label}</h2>
                                <p>{cat.description}</p>
                                <ul>
                                    {cat.pages.map((page) => (
                                        <li>
                                            <a href={pageHref(page.id)}>
                                                <strong>{page.label}</strong>
                                                <span>{page.description}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </section>

                    <section id="overview" class="doc-page" aria-label="Project overview and quick start">
                        <CurrentContent />
                    </section>
                </>
            ) : (
                <>
                    <nav class="breadcrumbs" aria-label="Breadcrumb">
                        <a href={`${docsBase}/`}>Manual</a>
                        <span aria-hidden="true">/</span>
                        <span>{currentCategory?.label ?? 'Page'}</span>
                    </nav>
                    <article id={requestedKey} class="doc-page">
                        <CurrentContent />
                    </article>
                    <nav class="doc-pager" aria-label="Previous and next page">
                        {prevPage ? (
                            <a class="pager-card previous" href={pageHref(prevPage.id)}>
                                <span>&larr; Previous</span>
                                <strong>{prevPage.label}</strong>
                            </a>
                        ) : <span></span>}
                        {nextPage ? (
                            <a class="pager-card next" href={pageHref(nextPage.id)}>
                                <span>Next &rarr;</span>
                                <strong>{nextPage.label}</strong>
                            </a>
                        ) : <span></span>}
                    </nav>
                    <p class="doc-feedback">
                        Spotted something wrong or out of date? <a href={editorUrl} target="_blank" rel="noopener noreferrer">Suggest an edit on GitHub</a>.
                    </p>
                </>
            )}
        </main>
    </div>

    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            const menuToggle = document.getElementById('menuToggle');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('overlay');
            const searchInput = document.getElementById('searchInput');
            const searchStatus = document.getElementById('searchStatus');
            const navItems = Array.from(document.querySelectorAll('.nav-item'));
            const docCards = Array.from(document.querySelectorAll('[data-doc-card]'));
            const categoryGroups = Array.from(document.querySelectorAll('[data-category]'));

            function setMenu(open) {
                sidebar?.classList.toggle('open', open);
                overlay?.classList.toggle('open', open);
                menuToggle?.setAttribute('aria-expanded', String(open));
            }

            menuToggle?.addEventListener('click', () => setMenu(!sidebar?.classList.contains('open')));
            overlay?.addEventListener('click', () => setMenu(false));
            navItems.forEach(item => item.addEventListener('click', () => {
                if (window.innerWidth <= 900) setMenu(false);
            }));

            searchInput?.addEventListener('input', (event) => {
                const query = event.target.value.trim().toLowerCase();
                navItems.forEach(item => {
                    const match = !query || item.dataset.searchText?.toLowerCase().includes(query);
                    item.parentElement.style.display = match ? '' : 'none';
                });
                categoryGroups.forEach(group => {
                    const visible = Array.from(group.querySelectorAll('li')).some(li => li.style.display !== 'none');
                    group.style.display = visible ? '' : 'none';
                });
                docCards.forEach(card => {
                    const match = !query || card.dataset.searchText?.toLowerCase().includes(query);
                    card.style.display = match ? '' : 'none';
                });
                const visibleRoutes = navItems.filter(item => item.parentElement.style.display !== 'none').length;
                if (searchStatus) {
                    searchStatus.textContent = query
                        ? (visibleRoutes ? `${visibleRoutes} matching pages` : 'Nothing matches')
                        : `${navItems.length} pages`;
                }
            });
        });
    </script>
</BaseLayout>
