---
/* Self-hosted fonts (the @fontsource packages, SIL Open Font License 1.1):
   Astro bundles each @font-face and its WOFF2 files into this site, so no page
   asks Google Fonts, or any other origin, for them. Pixelify Sans is the
   display face, Atkinson Hyperlegible the reading face, DM Mono the code face;
   only the weights and styles the CSS uses are imported. */
import "@fontsource/pixelify-sans/400.css";
import "@fontsource/pixelify-sans/500.css";
import "@fontsource/pixelify-sans/600.css";
import "@fontsource/pixelify-sans/700.css";
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/400-italic.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource/dm-mono/400.css";
import "@fontsource/dm-mono/500.css";
import "../styles/globals.css";
import Analytics from '../components/Analytics.astro';

interface Props {
    title?: string;
    description?: string;
    pageType?: 'game' | 'docs';
    /* Pages with no address of their own (the 404) stay out of search results. */
    noindex?: boolean;
}

const {
    title = "Super Mango — Platformer, Level Editor & Sandbox School",
    description = "Play a C11 + raylib platformer in your browser, build TOML worlds with the native visual editor, and learn game development through Sandbox School.",
    pageType = 'game',
    noindex = false,
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faviconHref = `${basePath}favicon.ico`;
const faviconPngHref = `${basePath}favicon.png`;
const favicon32Href = `${basePath}favicon-32x32.png`;
const appleTouchIconHref = `${basePath}apple-touch-icon.png`;
/* Link previews need an absolute address. Drawn by tools/render_og_image.py. */
const ogImageUrl = new URL(`${basePath}og-image.png`, Astro.site).toString();
const ogImageAlt = "Super Mango: the game's logo over a pixel-art mountain level, with Mango standing on the grass under a row of coins.";

const jsonLd = pageType === 'docs' ? {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    url: canonicalUrl,
} : {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: "Super Mango",
    description,
    url: canonicalUrl,
    genre: ["Platformer", "Indie", "Pixel Art"],
    gamePlatform: ["Web Browser", "macOS", "Linux", "Windows"],
    applicationCategory: "Game",
    operatingSystem: ["macOS", "Linux", "Windows", "Web"],
    programmingLanguage: "C11",
    author: [
        { "@type": "Person", name: "Jonathan Peris", url: "https://github.com/jonathanperis" },
        { "@type": "Person", name: "Fernando Santos", url: "https://github.com/fersantos" },
    ],
    isAccessibleForFree: true,
    license: "https://github.com/jonathanperis/super-mango-editor/blob/main/LICENSE",
    codeRepository: "https://github.com/jonathanperis/super-mango-editor",
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0f0e17" />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}
        <meta name="keywords" content="Super Mango, platformer, 2D game, pixel art, raylib, C11, WebAssembly, indie game, side-scroller, open source, game development" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        {!noindex && <meta property="og:url" content={canonicalUrl} />}
        <meta property="og:site_name" content="Super Mango" />
        <meta property="og:locale" content="en_US" />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:secure_url" content={ogImageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={ogImageAlt} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={ogImageAlt} />
        <meta name="twitter:creator" content="@jperis_silva" />

        {!noindex && <link rel="canonical" href={canonicalUrl} />}
        <link rel="icon" href={faviconHref} sizes="any" />
        <link rel="icon" type="image/png" href={faviconPngHref} />
        <link rel="icon" type="image/png" sizes="32x32" href={favicon32Href} />
        <link rel="apple-touch-icon" href={appleTouchIconHref} />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

        <title>{title}</title>
        {/* Third-party analytics never runs in the document hosting the game,
            whose profile lives in this origin's localStorage. Docs pages only. */}
        {pageType !== 'game' && <Analytics />}

        {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    </head>
    <body>
        <slot />
    </body>
</html>
