---
import "../styles/globals.css";
import Analytics from '../components/Analytics.astro';

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Super Mango - 2D Pixel Art Platformer",
    description = "A 2D pixel art platformer written in C11 + SDL2. Play in your browser via WebAssembly or download for macOS, Linux, and Windows.",
} = Astro.props;

const basePath = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faviconHref = `${basePath}favicon.ico`;
const faviconPngHref = `${basePath}favicon.png`;
const favicon32Href = `${basePath}favicon-32x32.png`;
const appleTouchIconHref = `${basePath}apple-touch-icon.png`;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    name: "Super Mango",
    description,
    url: canonicalUrl,
    genre: ["Platformer", "Indie", "Pixel Art"],
    gamePlatform: ["Web Browser", "macOS", "Linux", "Windows"],
    applicationCategory: "Game",
    operatingSystem: ["macOS", "Linux", "Windows", "Web"],
    programmingLanguage: "C11",
    author: [
        { "@type": "Person", name: "Jonathan Peris", url: "https://github.com/jonathanperis" },
        { "@type": "Person", name: "Fernando Santos", url: "https://github.com/fersantos" },
    ],
    isAccessibleForFree: true,
    license: "https://github.com/jonathanperis/super-mango-editor/blob/master/LICENSE",
    codeRepository: "https://github.com/jonathanperis/super-mango-editor",
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="theme-color" content="#0f0e17" />
        <meta name="description" content={description} />
        <meta name="keywords" content="Super Mango, platformer, 2D game, pixel art, SDL2, C11, WebAssembly, indie game, side-scroller, open source, game development" />

        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:site_name" content="Super Mango" />
        <meta property="og:locale" content="en_US" />

        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:creator" content="@jperis_silva" />

        <link rel="canonical" href={canonicalUrl} />
        <link rel="icon" href={faviconHref} sizes="any" />
        <link rel="icon" type="image/png" href={faviconPngHref} />
        <link rel="icon" type="image/png" sizes="32x32" href={favicon32Href} />
        <link rel="apple-touch-icon" href={appleTouchIconHref} />
        <link rel="dns-prefetch" href="https://www.googletagmanager.com" />

        <!-- Google Fonts: Pixelify Sans + DM Mono -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Pixelify+Sans:wght@400;600;700&family=DM+Mono:wght@400;500&display=swap"
            rel="stylesheet"
        />

        <title>{title}</title>
        <Analytics />

        <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    </head>
    <body>
        <slot />
    </body>
</html>
