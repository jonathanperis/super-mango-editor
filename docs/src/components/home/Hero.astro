---
/*
 * Title screen: a small level built from the game's real sprites (sky,
 * clouds, mountains, grass) with the hero walking in place, a spider on
 * patrol, a bird crossing and coins bobbing. Below it, a game-style dialog
 * box says what Super Mango is and offers the two things to do next.
 */
import Sprite from '@/components/Sprite.astro';
import { art } from '@/lib/art';
import facts from '../../generated/project.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sceneStyle = [
    `--sky:url("${art.sky.src}")`,
    `--clouds:url("${art.clouds.src}")`,
    `--clouds-near:url("${art.cloudsNear.src}")`,
    `--mountains:url("${art.mountains.src}")`,
    `--grass:url("${art.grassTile.src}")`,
].join(';');
---
<header class="title-screen" id="hero">
    <div class="scene" style={sceneStyle} aria-hidden="true">
        <div class="scene-layer scene-sky"></div>
        <div class="scene-layer scene-clouds"></div>
        <div class="scene-layer scene-mountains"></div>
        <div class="scene-layer scene-clouds-near"></div>

        <div class="scene-coins">
            <Sprite sheet={art.coin} scale={3} class="bob bob-1" />
            <Sprite sheet={art.coin} scale={3} class="bob bob-2" />
            <Sprite sheet={art.coin} scale={3} class="bob bob-3" />
            <Sprite sheet={art.starYellow} scale={3} class="bob bob-4" />
        </div>
        <Sprite sheet={art.bird} scale={2} frames={3} fps={7} class="scene-bird" />
        <Sprite sheet={art.player} scale={3} row={1} frames={4} fps={10} class="scene-player" />
        <Sprite sheet={art.spider} scale={2} frames={3} fps={7} class="scene-spider" />
        <div class="scene-ground"></div>
    </div>

    <div class="title-block">
        <h1 class="title-logo">
            <Sprite sheet={art.logo} scale={6} label="Super Mango" class="logo-sprite" />
        </h1>

        <div class="dialog-box">
            <p class="dialog-lead">
                A little platformer written in C.
                Play it here, then take it apart.
            </p>
            <p class="dialog-body">
                Every system in Super Mango is plain, commented C11 you can read in an
                afternoon: the game loop, collisions, the level loader, even the level
                editor. Built with raylib, it runs right here in your browser, and it is
                meant to be studied.
            </p>
            <div class="dialog-actions">
                <a href="#play" class="pixel-button pixel-button-gold" data-start-game="play">
                    <span aria-hidden="true">&#9654;</span> Play in the browser
                </a>
                <a href={`${base}/docs/learning-path/`} class="pixel-button pixel-button-ghost">
                    Learn how it works
                </a>
            </div>
            <p class="dialog-meta">
                <span>C11</span><span>raylib 6</span><span>{facts.levels} levels</span><span>{facts.assetMiB} MB of art &amp; sound</span><span>MIT</span>
            </p>
        </div>
    </div>
</header>
