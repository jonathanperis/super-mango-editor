---
import facts from '../../generated/project.json';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!-- Floating particles -->
<div class="particles" aria-hidden="true">
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
    <div class="particle"></div>
</div>

<section class="hero hero-overhaul" id="hero">
    <div class="parallax-layer sky-layer"></div>
    <div class="parallax-layer mountains-layer"></div>
    <div class="parallax-layer trees-far-layer"></div>
    <div class="parallax-layer trees-near-layer"></div>
    <div class="parallax-layer ground-layer"></div>

    <div class="hero-stage">
        <div class="hero-content">
            <div class="hero-badge boot-badge"><span class="signal-light"></span> NIGHT ARCADE SERVICE BAY</div>
            <div class="boot-readout" aria-label="Boot diagnostics">
                <span>BOOT://C11</span>
                <span>RAYLIB:6.0</span>
                <span>ASSETS:{facts.assetMiB}MiB</span>
            </div>
            <h1 class="hero-title overdrive-title">
                <span>SUPER</span>
                <span>MANGO</span>
            </h1>
            <p class="hero-sub">Insert coin, open the cabinet, rebuild the run.</p>
            <p class="hero-proof">A browser-playable C11 + raylib platformer with TOML worlds, a visual level editor, and a source tree designed to be studied like a working arcade machine.</p>
            <div class="hero-hud cabinet-ledger" aria-label="Project highlights">
                <span>C11</span>
                <span>raylib</span>
                <span>WASM</span>
                <span>{facts.levels} campaign levels</span>
                <span>{facts.labs} learning labs</span>
                <span>Level editor</span>
            </div>
            <div class="hero-ctas" aria-label="Primary actions">
                <a href="#play" class="btn-play" data-start-game="play">
                    <span class="btn-kicker">Insert coin</span>
                    <span class="btn-main">Boot normal run</span>
                </a>
                <a href="#docs" class="btn-download">
                    <span class="btn-kicker">Service panel</span>
                    <span class="btn-main">Open manual</span>
                </a>
            </div>
            <div class="hero-console" aria-label="Cabinet service log">
                <span>CHECKSUM: SOURCE-BACKED</span>
                <span>ROUTES: PLAYER / ENGINE / BUILDER</span>
                <span>STATUS: AWAITING COIN</span>
            </div>
        </div>

        <aside class="hero-attract-card" aria-label="Attract mode summary">
            <div class="attract-marquee diagnostic-marquee">
                <span class="live-dot"></span>
                <span>WEB BUILD READY</span>
                <strong>{facts.assetMiB} MiB assets</strong>
            </div>
            <div class="service-card-label">CABINET MONITOR</div>
            <div class="mini-cabinet" aria-hidden="true">
                <div class="mini-screen">
                    <span class="mini-sun"></span>
                    <span class="mini-platform one"></span>
                    <span class="mini-platform two"></span>
                    <span class="mini-player"></span>
                </div>
                <div class="mini-controls">
                    <span></span><span></span><span></span>
                </div>
            </div>
            <div class="attract-scoreboard">
                <div><span>LEVELS</span><strong>{facts.levels}</strong></div>
                <div><span>SCREENS</span><strong>{facts.screens}</strong></div>
                <div><span>LABS</span><strong>{facts.labs}</strong></div>
            </div>
            <a href={`${base}/docs/learning-path/`} class="attract-link">Start Sandbox School</a>
        </aside>
    </div>

    <a class="scroll-hint" href="#play">CABINET BELOW &darr;</a>
</section>
