---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="site-nav" id="site-nav" aria-label="Primary navigation">
    <a href={base || '#hero'} class="nav-logo" aria-label="Super Mango home">
        <span class="nav-logo-mark" aria-hidden="true">SM</span>
        <span class="nav-logo-copy">
            <span>Super Mango</span>
            <small>Arcade builder</small>
        </span>
    </a>
    <div class="nav-rail" aria-label="Page sections">
        <a href="#play">Play</a>
        <a href="#about">Scoreboard</a>
        <a href="#docs">Manual</a>
        <a href={`${base}/docs`}>Full docs</a>
        <a href="#downloads">Drops</a>
    </div>
    <a class="nav-start" href="#play">
        <span>Insert coin</span>
        <strong>Play</strong>
    </a>
</nav>
<nav class="mobile-action-bar" aria-label="Mobile quick actions">
    <a href="#play">Play</a>
    <a href="#docs">Manual</a>
    <a href="https://github.com/jonathanperis/super-mango-editor" target="_blank" rel="noreferrer noopener">GitHub</a>
</nav>
