---
/*
 * A plain top bar: the game's own coin icon as the mark, four destinations.
 * It stays put at the top of the page instead of appearing on scroll.
 * Off the home page (the 404), "Play" links back to the cabinet instead of
 * starting the game in place.
 */
import Sprite from '@/components/Sprite.astro';
import { art } from '@/lib/art';

interface Props {
    onHome?: boolean;
}

const { onHome = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<nav class="top-bar" aria-label="Primary navigation">
    <a href={`${base}/`} class="top-bar-home" aria-label="Super Mango home">
        <Sprite sheet={art.coin} scale={2} />
        <span>Super Mango</span>
    </a>
    <div class="top-bar-links">
        {onHome
            ? <a href="#play" data-start-game="play">Play</a>
            : <a href={`${base}/#play`}>Play</a>}
        <a href={`${base}/docs/learning-path/`}>Learn</a>
        <a href={`${base}/docs/`}>Manual</a>
        <a href="https://github.com/jonathanperis/super-mango-editor" target="_blank" rel="noreferrer noopener">GitHub</a>
    </div>
</nav>
