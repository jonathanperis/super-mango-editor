---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const scoreboard = [
    ['LEVELS', '3', 'TOML worlds'],
    ['SCREENS', '23', 'side-scroll rooms'],
    ['ENEMIES', '41', 'spawned threats'],
    ['HAZARDS', '64', 'traps & rails'],
    ['COLLECT', '80', 'coins, stars, hearts'],
];

const paths = [
    {
        label: 'PATH_01',
        title: 'Play',
        body: 'Start the WebAssembly build, learn the controls, and test the browser version without installing anything.',
        action: 'START RUN ->',
        href: '#play',
    },
    {
        label: 'PATH_02',
        title: 'Learn the engine',
        body: 'Follow the C11 + SDL2 architecture, game loop, rendering, collision, input, and entity systems.',
        action: 'OPEN GUIDE ->',
        href: `${base}/docs/developer-guide/`,
    },
    {
        label: 'PATH_03',
        title: 'Build levels',
        body: 'Inspect TOML worlds, asset rules, and the visual level editor workflow for extending the platformer.',
        action: 'WORLD BUILDER ->',
        href: `${base}/docs/level-editor/`,
    },
];

const manualGroups = [
    {
        label: 'MANUAL_01',
        title: 'Start here',
        body: 'Project overview, codebase map, and the first walkthrough for new contributors.',
        links: [
            { title: 'README', href: 'https://github.com/jonathanperis/super-mango-editor#readme', external: true },
            { title: 'Developer Guide', href: `${base}/docs/developer-guide/`, external: false },
            { title: 'Architecture', href: `${base}/docs/architecture/`, external: false },
        ],
        action: 'OPEN STARTER ROUTE ->',
    },
    {
        label: 'MANUAL_02',
        title: 'Core systems',
        body: 'Player lifecycle, entities, hazards, constants, collectibles, and platform surfaces.',
        links: [
            { title: 'Player Module', href: `${base}/docs/player-module/`, external: false },
            { title: 'Entities & Hazards', href: `${base}/docs/entities-and-hazards/`, external: false },
            { title: 'Constants', href: `${base}/docs/constants-reference/`, external: false },
            { title: 'Collectibles', href: `${base}/docs/collectibles-and-surfaces/`, external: false },
        ],
        action: 'STUDY SYSTEMS ->',
    },
    {
        label: 'MANUAL_03',
        title: 'World builder',
        body: 'Level format, visual editor, sprites, audio, and content authoring references.',
        links: [
            { title: 'Level Design', href: `${base}/docs/level-design/`, external: false },
            { title: 'Level Editor', href: `${base}/docs/level-editor/`, external: false },
            { title: 'Assets', href: `${base}/docs/assets/`, external: false },
            { title: 'Sounds', href: `${base}/docs/sounds/`, external: false },
        ],
        action: 'BUILD A LEVEL ->',
    },
    {
        label: 'MANUAL_04',
        title: 'Build & source',
        body: 'Make targets, source-file ownership, native builds, WebAssembly, and validation gates.',
        links: [
            { title: 'Build System', href: `${base}/docs/build-system/`, external: false },
            { title: 'Source Files', href: `${base}/docs/source-files/`, external: false },
            { title: 'Full Docs', href: `${base}/docs`, external: false },
        ],
        action: 'OPEN TOOLCHAIN ->',
    },
];
---

<section id="play" class="play-section cabinet-bay" data-asset-base={`${base}/`}>
    <div class="section-kicker">CABINET BAY</div>
    <h2 class="section-title">BOOT THE RUN</h2>
    <p class="section-lede">Normal Play now boots from every play CTA. Debug Mode is kept as a developer diagnostic path with the same WebAssembly payload plus <code>--debug</code>.</p>
    <div class="boot-lanes" aria-label="Play modes">
        <button class="boot-lane active" type="button" data-start-game="play"><span>PLAYER MODE</span><strong>Normal run</strong></button>
        <button class="boot-lane" type="button" data-start-game="debug"><span>DEV MODE</span><strong>Hitboxes + FPS</strong></button>
        <a class="boot-lane link" href="#docs"><span>SERVICE</span><strong>Open manual</strong></a>
    </div>
    <div class="cabinet-frame">
        <div class="cabinet-marquee">
            <span>WEBASSEMBLY BUILD</span>
            <strong>READY</strong>
        </div>
        <div class="cabinet-bezel">
            <canvas
                id="canvas"
                role="application"
                aria-label="Super Mango game canvas - press Play to start"
            ></canvas>
            <p id="game-status">
                <span class="cabinet-standby">WebAssembly cabinet ready</span>
                <span class="cabinet-standby-note">Click to load the browser build and start the run.</span>
                <button id="play-btn" type="button" data-start-game="play">Play normal run (~43 MB)</button>
                <button id="debug-btn" type="button" data-start-game="debug">Debug mode: hitboxes + FPS</button>
            </p>
        </div>
        <div class="cabinet-controls">
            <span class="control-group"><kbd>WASD</kbd> / <kbd>Arrows</kbd> Move</span>
            <span class="control-group"><kbd>Space</kbd> Jump</span>
            <span class="control-note">Keyboard recommended · scroll resumes after the canvas loses focus</span>
        </div>
        <div class="cabinet-base"></div>
    </div>
</section>

<section id="about" class="about-section">
    <div class="section-kicker">SCOREBOARD</div>
    <h2 class="section-title">PLAY, STUDY, REBUILD</h2>
    <p class="section-lede">
        Super Mango is a classic side-scrolling platformer and a commented learning resource for C and SDL2 game programming.
        It keeps the game loop, rendering, input, collision, assets, WebAssembly build, and level tooling visible.
    </p>

    <div class="world-map-rail" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
    <div class="scoreboard-grid world-node-grid" aria-label="Project metrics">
        {scoreboard.map(([label, value, note]) => (
            <div class="score-tile">
                <span>{label}</span>
                <strong>{value}</strong>
                <em>{note}</em>
            </div>
        ))}
    </div>

    <div class="section-kicker sub-kicker">PLAYER / ENGINE / BUILDER</div>
    <div class="path-grid portal-grid">
        {paths.map((path) => (
            <a class="path-card" href={path.href}>
                <span class="card-label">{path.label}</span>
                <h3>{path.title}</h3>
                <p>{path.body}</p>
                <span class="card-action">{path.action}</span>
            </a>
        ))}
    </div>

    <div class="feature-grid inventory-grid">
        <div class="feature-card">
            <span class="card-label">INV_01</span>
            <h3>Platforming</h3>
            <p>One-way platforms, float platforms, crumble bridges, floor gaps, bouncepads, vines, ladders, and ropes.</p>
        </div>
        <div class="feature-card">
            <span class="card-label">INV_02</span>
            <h3>Enemies</h3>
            <p>Spiders, jumping spiders, birds, faster birds, fish, and faster fish across hand-authored TOML levels.</p>
        </div>
        <div class="feature-card">
            <span class="card-label">INV_03</span>
            <h3>Hazards</h3>
            <p>Spike rows, spike platforms, axe traps, circular saws, blue flames, fire flames, and rail blocks.</p>
        </div>
        <div class="feature-card">
            <span class="card-label">INV_04</span>
            <h3>Visual polish</h3>
            <p>Parallax scrolling, player animation states, camera tracking, fog overlay, HUD, and pixel-perfect rendering.</p>
        </div>
        <div class="feature-card">
            <span class="card-label">INV_05</span>
            <h3>Level editor</h3>
            <p>Standalone SDL2 editor with canvas tools, palette, properties, validation, autosave, export, and play-test integration.</p>
        </div>
        <div class="feature-card">
            <span class="card-label">INV_06</span>
            <h3>Cross-platform</h3>
            <p>Native builds for macOS, Linux, and Windows, plus a browser-playable Emscripten/WebAssembly build.</p>
        </div>
    </div>
</section>

<section id="docs" class="docs-section">
    <div class="section-kicker">BUILDER MANUAL</div>
    <h2 class="section-title">CHOOSE YOUR ROUTE</h2>
    <p class="section-lede">The landing page now groups docs by intent. Use the full manual when you need the exhaustive index.</p>
    <div class="docs-cta-row">
        <a href={`${base}/docs`} class="docs-link-btn">View full documentation &rarr;</a>
    </div>
    <div class="docs-grid manual-grid">
        {manualGroups.map((group) => (
            <article class="doc-card manual-card">
                <span class="card-label">{group.label}</span>
                <h3>{group.title}</h3>
                <p>{group.body}</p>
                <ul class="manual-links">
                    {group.links.map((link) => (
                        <li>
                            <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer noopener' : undefined}>{link.title}</a>
                        </li>
                    ))}
                </ul>
                <span class="card-action">{group.action}</span>
            </article>
        ))}
    </div>
</section>

<section id="downloads" class="downloads-section">
    <div class="section-kicker">ITEM DROP</div>
    <h2 class="section-title">CHOOSE YOUR CARTRIDGE</h2>
    <p class="section-lede">
        Download builds for your platform from GitHub Releases, or return to the WebAssembly cabinet for no-install browser play.
        Native builds should run from the repository root so they can find <code>assets/</code>.
    </p>
    <div class="download-grid">
        <a class="download-card" href="https://github.com/jonathanperis/super-mango-editor/releases/latest" target="_blank" rel="noreferrer noopener" aria-label="Download Super Mango for Linux x86_64">
            <span class="card-label">DROP_01</span>
            <div class="platform">Linux</div>
            <div class="arch">x86_64</div>
            <span class="card-action">OPEN RELEASE -></span>
        </a>
        <a class="download-card" href="https://github.com/jonathanperis/super-mango-editor/releases/latest" target="_blank" rel="noreferrer noopener" aria-label="Download Super Mango for macOS Apple Silicon">
            <span class="card-label">DROP_02</span>
            <div class="platform">macOS</div>
            <div class="arch">arm64 Apple Silicon</div>
            <span class="card-action">OPEN RELEASE -></span>
        </a>
        <a class="download-card" href="https://github.com/jonathanperis/super-mango-editor/releases/latest" target="_blank" rel="noreferrer noopener" aria-label="Download Super Mango for Windows x86_64">
            <span class="card-label">DROP_03</span>
            <div class="platform">Windows</div>
            <div class="arch">x86_64 + SDL2 DLLs</div>
            <span class="card-action">OPEN RELEASE -></span>
        </a>
        <a class="download-card wasm-drop" href="#play" aria-label="Play Super Mango in browser using WebAssembly">
            <span class="card-label">DROP_04</span>
            <div class="platform">WebAssembly</div>
            <div class="arch">No install · play above</div>
            <span class="card-action">PLAY ABOVE -></span>
        </a>
    </div>
</section>

<script is:inline>
    const canvas = document.getElementById('canvas');
    const statusEl = document.getElementById('game-status');
    const playBtn = document.getElementById('play-btn');
    const debugBtn = document.getElementById('debug-btn');
    const gameAssetBase = document.getElementById('play')?.dataset.assetBase || './';

    canvas?.addEventListener('contextmenu', (event) => event.preventDefault());

    let gameBooted = false;

    function startGame(debug = false) {
        if (!canvas || !statusEl || !playBtn || gameBooted) return;
        gameBooted = true;

        playBtn.disabled = true;
        if (debugBtn) debugBtn.disabled = true;
        playBtn.textContent = debug ? 'Loading diagnostics...' : 'Loading run...';
        canvas.tabIndex = -1;
        statusEl.dataset.mode = debug ? 'debug' : 'play';
        statusEl.innerHTML = `<span class="spinner"></span>${debug ? 'Booting developer diagnostics...' : 'Downloading normal game data...'}`;

        const args = ['--sandbox'];
        if (debug) args.push('--debug');

        canvas.addEventListener('webglcontextlost', (event) => {
            alert('WebGL context lost - please reload the page.');
            event.preventDefault();
        }, false);

        const handleKeyDown = (event) => {
            if ([32, 37, 38, 39, 40, 16, 65, 68, 83, 87].includes(event.keyCode)) {
                event.preventDefault();
            }
        };
        document.addEventListener('keydown', handleKeyDown, false);

        const Module = {
            arguments: args,
            canvas,
            print(text) { console.log(`[Super Mango] ${text}`); },
            printErr(text) {
                console.error(`[Super Mango] ${text}`);
                if (String(text).toLowerCase().includes('error')) {
                    statusEl.style.display = '';
                    statusEl.textContent = `Runtime error: ${text}`;
                }
            },
            setStatus(text) {
                if (!text) {
                    statusEl.style.display = 'none';
                    playBtn.style.display = 'none';
                } else {
                    statusEl.innerHTML = text.includes('Downloading')
                        ? '<span class="spinner"></span>' + text
                        : text;
                    statusEl.style.display = '';
                }
            },
            monitorRunDependencies(left) {
                if (left === 0) {
                    Module.setStatus('');
                    canvas.focus();
                }
            },
        };

        window['Module'] = Module;

        const script = document.createElement('script');
        script.src = `${gameAssetBase}super-mango.js`;
        script.onerror = () => {
            gameBooted = false;
            statusEl.innerHTML = 'Failed to load game files. Try refreshing the page.';
            playBtn.style.display = 'inline-block';
            playBtn.disabled = false;
            playBtn.textContent = 'Retry normal run (~43 MB)';
            if (debugBtn) {
                debugBtn.style.display = 'inline-block';
                debugBtn.disabled = false;
            }
            document.removeEventListener('keydown', handleKeyDown);
        };
        document.body.appendChild(script);
    }

    function requestGameStart(debug = false) {
        document.getElementById('play')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        window.setTimeout(() => startGame(debug), 120);
    }

    playBtn?.addEventListener('click', (event) => { event.preventDefault(); requestGameStart(false); });
    debugBtn?.addEventListener('click', (event) => { event.preventDefault(); requestGameStart(true); });
    document.querySelectorAll('[data-start-game]').forEach((control) => {
        control.addEventListener('click', (event) => {
            event.preventDefault();
            requestGameStart(control.getAttribute('data-start-game') === 'debug');
        });
    });
</script>
