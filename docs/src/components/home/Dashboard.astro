---
/*
 * Everything below the title screen: the playable cabinet, what is in the
 * game, how to learn from it, the manual index and the downloads.
 *
 * The inline script at the bottom boots the WebAssembly build. It relies on
 * these ids and classes, which must keep their names: #play (with
 * data-asset-base), #game-viewport, #canvas, #game-status,
 * .cabinet-standby, .cabinet-standby-note, #play-btn, #debug-btn,
 * #touch-controls and the [data-start-game] buttons.
 */
import Sprite from '@/components/Sprite.astro';
import CategoryMark from '@/components/CategoryMark.astro';
import { art } from '@/lib/art';
import { DOCS_META, SECTION_CATEGORIES } from '@/lib/docsSidebar';
import facts from '../../generated/project.json';
import gameLoopSource from '../../../../src/core/game_loop.c?raw';
import { sourceExcerpt } from '@/lib/sourceExcerpt';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const loopExcerpt = sourceExcerpt('src/core/game_loop.c', gameLoopSource, 'int steps = game_inspector_steps', '\n\n    /* ---- 4. Render');

const hud = [
    { sprite: art.lastStar, value: facts.levels, label: 'levels', note: `${facts.screens} screens to cross` },
    { sprite: art.coin, value: facts.collectibles, label: 'coins & stars', note: 'placed by hand' },
    { sprite: art.spider, value: facts.enemies, label: 'enemies', note: 'six kinds', scale: 1 },
    { sprite: art.saw, value: facts.hazards, label: 'hazards', note: 'saws, axes, flames, spikes', scale: 2 },
    { sprite: art.starYellow, value: facts.labs, label: 'lab levels', note: 'one idea each' },
];

const bestiary = [
    { name: 'Spider', sprite: art.spider, frames: 3, scale: 2, line: 'Patrols its ledge, turns at the edge. The jumping kind does not turn.' },
    { name: 'Bird', sprite: art.bird, frames: 3, scale: 2, line: 'Flies a slow sine wave across the sky. Duck or time it.' },
    { name: 'Fish', sprite: art.fish, frames: 2, scale: 2, line: 'Waits under the water, then leaps at exactly the wrong moment.' },
    { name: 'Circular saw', sprite: art.saw, frames: 1, scale: 3, line: 'Rolls back and forth along its track. As dangerous as it looks.' },
    { name: 'Axe trap', sprite: art.axe, frames: 1, scale: 2, line: 'Swings on a schedule. Learn the schedule.' },
    { name: 'Blue flame', sprite: art.flame, frames: 2, scale: 2, line: 'Erupts from the gaps in the floor. Jump between bursts.' },
];

const learnLinks = [
    { title: 'Sandbox School', note: 'eight small experiments, from your first frame to a reproducible replay', href: `${base}/docs/learning-path/` },
    { title: 'Mechanics Museum', note: 'six tiny levels, each showing one mechanic in isolation', href: `${base}/docs/mechanics-museum/` },
    { title: 'Entity walkthrough', note: 'follow one collectible from TOML to screen, editor and tests', href: `${base}/docs/entity-walkthrough/` },
    { title: 'Level editor', note: 'build your own level with the same editor we use', href: `${base}/docs/level-editor/` },
];

const manualColumns = SECTION_CATEGORIES.map(category => ({
    label: category.label,
    pages: category.ids.map(id => DOCS_META[id]),
}));
---

<section id="play" class="section play-section" data-asset-base={`${base}/`} aria-labelledby="play-title">
    <div class="section-head">
        <Sprite sheet={art.coin} scale={3} />
        <div>
            <h2 id="play-title">Press start</h2>
            <p>You begin in Creator's Playground. Debug mode is the same game with the inspector switched on: every hitbox drawn, and time you can freeze, step and slow down.</p>
        </div>
    </div>

    <div class="cabinet">
        <div id="game-viewport" class="game-viewport">
            <div class="cabinet-screen" style={`--poster-sky:url("${art.sky.src}");--poster-mountains:url("${art.mountains.src}")`}>
                <canvas
                    id="canvas"
                    role="application"
                    aria-label="Super Mango game canvas - press Play to start"
                ></canvas>
                <p id="game-status">
                    <span class="cabinet-standby">Ready when you are</span>
                    <span class="cabinet-standby-note">The game downloads only when you press play: about {facts.assetMiB} MB of art and sound plus the engine.</span>
                    <button id="play-btn" type="button" data-start-game="play">&#9654; Play</button>
                    <button id="debug-btn" type="button" data-start-game="debug">Play with the debug inspector</button>
                </p>
            </div>
            <div id="touch-controls"></div>
        </div>
        <ul class="controls-legend" aria-label="Keyboard controls">
            <li><kbd>&larr;</kbd><kbd>&rarr;</kbd> or <kbd>A</kbd><kbd>D</kbd> move</li>
            <li><kbd>Space</kbd> jump</li>
            <li><kbd>Shift</kbd> run</li>
            <li><kbd>Esc</kbd> pause</li>
            <li><kbd>F1</kbd> settings</li>
            <li class="controls-note">Gamepads work too, and phones get touch buttons. <kbd>Tab</kbd> leaves the game.</li>
        </ul>
    </div>
</section>

<section id="about" class="section cartridge-section" aria-labelledby="cartridge-title">
    <div class="section-head">
        <Sprite sheet={art.starYellow} scale={3} />
        <div>
            <h2 id="cartridge-title">What's in the cartridge</h2>
            <p>Three hand-built levels, from a grassy playground to two volcanic stages, plus six small lab levels for studying one mechanic at a time.</p>
        </div>
    </div>

    <ul class="hud-strip" aria-label="Game contents">
        {hud.map(item => (
            <li>
                <Sprite sheet={item.sprite} scale={item.scale ?? 2} />
                <strong><span aria-hidden="true">x</span>{item.value}</strong>
                <span class="hud-label">{item.label}</span>
                <span class="hud-note">{item.note}</span>
            </li>
        ))}
    </ul>

    <h3 class="bestiary-title">Who you'll meet</h3>
    <ul class="bestiary">
        {bestiary.map(entry => (
            <li>
                <div class="bestiary-portrait">
                    <Sprite sheet={entry.sprite} scale={entry.scale} frames={entry.frames} fps={6} />
                </div>
                <h4>{entry.name}</h4>
                <p>{entry.line}</p>
            </li>
        ))}
    </ul>
</section>

<section id="learn" class="section learn-section" aria-labelledby="learn-title">
    <div class="learn-copy">
        <h2 id="learn-title">Learn C by taking it apart</h2>
        <p>
            Super Mango started as a way to learn C properly, by building something
            we actually wanted to play. So the code prefers being readable over being
            clever: simple loops, explicit ownership, and comments that explain <em>why</em>, not just what.
        </p>
        <p>
            Nothing is hidden behind an engine. Open any file and you are one or two
            function calls away from raylib.
        </p>
        <ul class="learn-links">
            {learnLinks.map(link => (
                <li>
                    <a href={link.href}>{link.title}</a>
                    <span>{link.note}</span>
                </li>
            ))}
        </ul>
    </div>

    <figure class="code-card">
        <figcaption>
            <span class="code-file">src/core/game_loop.c</span>
            <span class="code-note">pulled from the source when this page was built</span>
        </figcaption>
        <pre><code>{loopExcerpt}</code></pre>
        <p class="code-explainer">
            Every frame turns real time into a whole number of fixed 1/60 s steps.
            That is why a jump reaches the same height at 60 Hz and at 144 Hz, and
            why a recorded run replays exactly.
        </p>
    </figure>
</section>

<section id="docs" class="section manual-section" aria-labelledby="manual-title">
    <div class="section-head">
        <Sprite sheet={art.lastStar} scale={3} />
        <div>
            <h2 id="manual-title">The manual</h2>
            <p>Every page was written next to the code it describes, and checked against it.</p>
        </div>
    </div>
    <div class="manual-index">
        {manualColumns.map(column => (
            <div class="manual-column">
                <h3><CategoryMark category={column.label} />{column.label}</h3>
                <ul>
                    {column.pages.map(page => (
                        <li><a href={`${base}${page.route}`}>{page.label}</a></li>
                    ))}
                </ul>
            </div>
        ))}
    </div>
    <a class="pixel-button pixel-button-ghost manual-all" href={`${base}/docs/`}>Open the manual</a>
</section>

<section id="downloads" class="section downloads-section" aria-labelledby="downloads-title">
    <h2 id="downloads-title">Take it home</h2>
    <p>
        Native builds for each platform come with every tagged release. To get the
        level editor and the learning labs too, build from source with <a href={`${base}/docs/build-system/`}><code>make builder</code></a>.
    </p>
    <div class="download-row">
        <a class="pixel-button pixel-button-ghost" href="https://github.com/jonathanperis/super-mango-editor/releases/latest" target="_blank" rel="noreferrer noopener" aria-label="Download Super Mango for Linux x86_64">Linux <small>x86_64</small></a>
        <a class="pixel-button pixel-button-ghost" href="https://github.com/jonathanperis/super-mango-editor/releases/latest" target="_blank" rel="noreferrer noopener" aria-label="Download Super Mango for macOS Apple Silicon">macOS <small>Apple Silicon</small></a>
        <a class="pixel-button pixel-button-ghost" href="https://github.com/jonathanperis/super-mango-editor/releases/latest" target="_blank" rel="noreferrer noopener" aria-label="Download Super Mango for Windows x86_64">Windows <small>x86_64</small></a>
    </div>
</section>

<script is:inline>
    const canvas = document.getElementById('canvas');
    const statusEl = document.getElementById('game-status');
    const playBtn = document.getElementById('play-btn');
    const debugBtn = document.getElementById('debug-btn');
    const gameViewport = document.getElementById('game-viewport');
    const statusMessage = statusEl?.querySelector('.cabinet-standby');
    const statusNote = statusEl?.querySelector('.cabinet-standby-note');
    const gameAssetBase = document.getElementById('play')?.dataset.assetBase || './';

    canvas?.addEventListener('contextmenu', (event) => event.preventDefault());

    let gameBooted = false;
    let reloadRequired = false;
    let touchControls = null;

    function startGame(debug = false) {
        if (reloadRequired) { window.location.reload(); return; }
        if (!canvas || !statusEl || !playBtn || gameBooted) return;
        gameBooted = true;

        playBtn.disabled = true;
        if (debugBtn) debugBtn.disabled = true;
        playBtn.textContent = debug ? 'Loading diagnostics...' : 'Loading run...';
        canvas.tabIndex = 0;
        statusEl.dataset.mode = debug ? 'debug' : 'play';
        playBtn.style.display = 'none';
        if (debugBtn) debugBtn.style.display = 'none';
        if (statusNote) statusNote.style.display = 'none';
        if (statusMessage) statusMessage.textContent = debug ? 'Booting developer diagnostics...' : 'Downloading normal game data...';

        // Replay restarts the level inside the running game, so the page
        // always boots the sandbox level.
        const args = ['--level', 'levels/00_sandbox_01.toml'];
        if (debug) args.push('--debug');

        const handleContextLoss = (event) => {
            event.preventDefault();
            showFailure('WebGL context lost. Reload to continue.', true);
        };
        canvas.addEventListener('webglcontextlost', handleContextLoss, false);

        const handleKeyDown = (event) => {
            if (document.activeElement !== canvas) return;
            // Run before the canvas backend listeners: leaving default handling to
            // them would consume Tab and trap focus inside the canvas.
            const modifierOnly = /^(Control|Meta)(Left|Right)$/.test(event.code);
            if (event.code === 'Tab' || ((event.ctrlKey || event.metaKey) && !modifierOnly)) {
                event.stopImmediatePropagation();
                return;
            }
            if (!event.ctrlKey && !event.metaKey) event.preventDefault();
        };
        document.addEventListener('keydown', handleKeyDown, true);

        function showFailure(message, needsReload) {
            if (touchControls) touchControls.setEnabled(false);
            gameBooted = false;
            reloadRequired = needsReload;
            canvas.setAttribute('aria-label', 'Super Mango game canvas - not running');
            document.removeEventListener('keydown', handleKeyDown, true);
            canvas.removeEventListener('webglcontextlost', handleContextLoss);
            statusEl.style.display = '';
            if (statusMessage) statusMessage.textContent = message;
            playBtn.style.display = 'inline-block';
            playBtn.disabled = false;
            playBtn.textContent = needsReload ? 'Reload game' : 'Retry normal run';
            if (debugBtn) { debugBtn.style.display = 'inline-block'; debugBtn.disabled = false; }
            playBtn.focus();
        }

        const moduleConfig = {
            arguments: args,
            canvas,
            print(text) { console.log(`[Super Mango] ${text}`); },
            printErr(text) {
                console.error(`[Super Mango] ${text}`);
            },
            onAbort() { showFailure('Game startup failed. Reload to retry.', true); },
            onGameEnded(fatal, profileError) {
                showFailure(fatal ? 'Game ended with an error.' : profileError
                    ? 'Run ended. Profile changes were not saved.' : 'Run ended. Play again?', true);
            },
            setStatus(text) {
                if (!text) {
                    statusEl.style.display = 'none';
                    playBtn.style.display = 'none';
                } else {
                    if (statusMessage) statusMessage.textContent = text;
                    statusEl.style.display = '';
                }
            },
            monitorRunDependencies(left) {
                if (left === 0) {
                    moduleConfig.setStatus('Launching run...');
                }
            },
            onRuntimeInitialized() {
                if (!touchControls) touchControls = window.SuperMangoTouch.mount(
                    document.getElementById('touch-controls'), canvas,
                    (action, pressed) => {
                        if (pressed) gameViewport?.scrollIntoView({block: 'start', behavior: 'instant'});
                        return moduleConfig._game_web_input_touch(action, pressed);
                    });
                moduleConfig.clearTouchInput = () => touchControls.clear();
                canvas.focus({preventScroll: true});
                moduleConfig.setStatus('');
                window.setTimeout(() => {
                    if (moduleConfig.__superMangoMainStarted) return;
                    moduleConfig.__superMangoMainStarted = true;
                    try {
                        const code = moduleConfig.callMain(moduleConfig.arguments || []);
                        if (code) showFailure('Game startup failed. Reload to retry.', true);
                        else {
                            touchControls.setEnabled(true);
                            canvas.setAttribute('aria-label', 'Super Mango game canvas - running; F1 opens settings');
                            gameViewport?.scrollIntoView({block: 'start', behavior: 'instant'});
                        }
                    } catch (error) {
                        console.error('[Super Mango] startup failed', error);
                        showFailure('Game startup failed. Reload to retry.', true);
                    }
                }, 0);
            },
        };

        window.Module = moduleConfig;

        const script = document.createElement('script');
        script.src = `${gameAssetBase}super-mango.js`;
        script.onerror = () => {
            if (touchControls) { touchControls.destroy(); touchControls = null; }
            script.remove();
            showFailure('Failed to load game files. Retry the download.', false);
        };
        document.body.appendChild(script);
    }

    function requestGameStart(debug = false) {
        const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        document.getElementById('play')?.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
        window.setTimeout(() => startGame(debug), 120);
    }

    document.querySelectorAll('[data-start-game]').forEach((control) => {
        control.addEventListener('click', (event) => {
            event.preventDefault();
            requestGameStart(control.getAttribute('data-start-game') === 'debug');
        });
    });
</script>
